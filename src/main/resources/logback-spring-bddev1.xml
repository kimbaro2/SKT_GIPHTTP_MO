<configuration>
    <turboFilter class="com.infra.mo.skt_giphttp_mo.config.application.ThreadCustomGradeFilter"/>

    <property name="PORT" value="7500"/>

    <springProperty name="P_FILE_PATH" source="witcom.performance.pFilePath" defaultValue="/log/BRTBV-SMSS-APP01/"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{HH:mm:ss.SSS}] [%-5level] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${P_FILE_PATH}GIPHTTPMO_P_${PORT}_%d{MMdd_HH}</fileNamePattern>
        </rollingPolicy>

        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%-5level] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Hibernate DEBUG 로그 제거 -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.loader" level="WARN"/>
    <logger name="org.hibernate.engine" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>

    <logger name="com.infra.recv.skt_giphttp_mo.config.application.WitcomLog" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="com.infra.recv.skt_giphttp_mo" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>